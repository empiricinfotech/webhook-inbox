# Documentation only; use npm run local:inbox -- init for private random values.
# The operator command reads apps/api/.env.inbox.local, not the API's .env.local.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/webhook_inbox?directConnection=true
LOCAL_OWNER_ID=
LOCAL_WORKSPACE_ID=
LOCAL_WORKSPACE_NAME=Local workspace
CAPTURE_TOKEN_KEY_VERSION=local-v1
CAPTURE_TOKEN_KEY_HEX=
# Optional local dashboard overrides (defaults shown); API binds to 127.0.0.1.
# Match this web origin to the browser and API_ORIGIN to API_PORT in web config.
API_PORT=4000
LOCAL_WEB_ORIGIN=http://127.0.0.1:3000
