{
  "name": "@empiric-webhook-inbox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.11.2",
    "zod": "4.6.7",
    "pino": "10.4.0",
    "@empiric-webhook-inbox/contracts": "0.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "local:inbox": "node --env-file-if-exists=.env.inbox.local dist/local-inbox.js",
    "local:dashboard": "node --env-file-if-exists=.env.inbox.local dist/local-dashboard.js"
  }
}
